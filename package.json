{
  "name": "safal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "env:check": "tsx --env-file=.env.local scripts/check-env.ts",
    "env:check:live": "tsx --env-file=.env.local scripts/check-env.ts --live",
    "seed:users": "tsx --env-file=.env.local scripts/seed-users.ts",
    "verify:rls": "tsx --env-file=.env.local scripts/verify-isolation.ts",
    "verify:teacher-http": "tsx --conditions=react-server --env-file=.env.local scripts/integration/teacher-http-final.ts",
    "verify:stage1": "tsx --conditions=react-server --env-file=.env.local scripts/integration/stage1-http.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "check:full": "npm run check && npm run verify:rls"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
