# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# Never paste these values into chat, screenshots or the README.

# --- Supabase ---
# Project URL. Supabase dashboard: click "Connect" (top bar) > "API" tab, or Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# PUBLISHABLE key (starts with sb_publishable_). Safe for the browser; grants + row-level security protect data.
# Dashboard: Project Settings > API Keys > "Publishable key" (or the Connect dialog).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET key (starts with sb_secret_). SERVER ONLY. Bypasses row-level security. Never prefix with NEXT_PUBLIC_.
# Dashboard: Project Settings > API Keys > "Secret keys" > reveal/copy. Create one named "safal-server" if none exists.
SUPABASE_SECRET_KEY=
# (Older projects only: NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY still work as fallbacks.
#  Leave them out for a new project.)

# --- SAFAL's tutor AI (separate from the model Cline uses to write code) ---
# mock = built-in fake responses for development. Every mock result is labelled "MOCK AI" in the UI.
# live = real provider (not wired up yet; selecting it fails with a clear message until configured).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# --- Demo accounts: passwords for the FICTIONAL users, used only by `npm run seed:users` ---
# Choose your own; at least 8 characters. Do not reuse a real password.
DEMO_TEACHER_PASSWORD=
DEMO_STUDENT_A_PASSWORD=
DEMO_STUDENT_B_PASSWORD=
